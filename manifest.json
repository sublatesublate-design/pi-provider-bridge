  "author": "sublatesublate-design",
  "i18n": {
    "en": {
      "name": "TUI Provider Bridge (Desktop)",
      "description": "Native Antigravity Google subscription for Gemini through an authenticated loopback gateway; OpenCode Go retained. Both subscriptions expose read-only quota to the Host.",
      "safetyNotes": "Uses OAuth credentials supplied by the user, keeps the gateway on loopback, and sends quota requests only to the declared provider domains."
    },
    "zh-CN": {
      "name": "桌面端供应商桥接",
      "description": "为 Antigravity 和 OpenCode Go 订阅提供登录、模型桥接和只读额度查询。",
      "safetyNotes": "使用用户主动登录取得的 OAuth 凭据；网关仅监听本机回环地址；额度请求仅发送到清单声明的服务域名。"
    }
  },
  "categories": [
    "developer-tools",
    "productivity"
  ],
  "changelog": {
    "en": "Adds three independent Antigravity account slots and moves the gateway and OAuth callback to verified available loopback ports.",
    "zh-CN": "新增三个独立的 Antigravity 账户槽位，并将网关和 OAuth 回调迁移到已验证可用的本机端口。"
  }
}
